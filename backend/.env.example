# Copy this file to backend/.env for local development only.
# For Ubuntu production, put the same variables in /etc/locket-gold.env.
PORT=5001
BEHIND_HTTPS=0

# Admin Unified Authentication & Provisioning
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=Administrator
ADMIN_ALLOW_GOOGLE_LOGIN=0
FLASK_SECRET_KEY=replace-with-an-independent-random-64-hex-secret

# Database and storage
# The application reads LOCKET_DB (not LOCKET_DB_PATH).
LOCKET_DB=locket.db
REVIEW_STORAGE_ROOT=storage/reviews
CREATOR_STORAGE_ROOT=storage/creators
MOBILECONFIG_PATH=
ANDROID_APK_PATH=
ANDROID_APK_DOWNLOAD_URL=https://www.mediafire.com/file/hyleb7laxt89jzk/Locket_v1.200.0-gocmod.com.apk/file
ANDROID_APK_ALLOWED_HOSTS=mediafire.com,www.mediafire.com
ENABLE_ACCEL_REDIRECT=0

# Feedback image storage
# Supported target values: local | cloudinary
# Use local for development. Switch to cloudinary only after filling all three
# Cloudinary credentials. CLOUDINARY_API_SECRET must remain backend-only.
REVIEW_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=locket-gold/reviews
CLOUDINARY_CREATOR_FOLDER=locket-gold/creators

# Customer access/refresh tokens
# Generate FLASK_SECRET_KEY, JWT_SECRET and REFRESH_TOKEN_PEPPER separately.
JWT_SECRET=replace-with-an-independent-random-64-hex-secret
REFRESH_TOKEN_PEPPER=replace-with-an-independent-random-64-hex-secret
JWT_ISSUER=locket-gold
JWT_AUDIENCE=locket-gold-web
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=locket_refresh

# Google Identity Services
# This must exactly match frontend VITE_GOOGLE_CLIENT_ID.
# Authorized JavaScript origins in Google Cloud:
#   http://localhost:3000
#   https://locketgoldhuy.io.vn
# Do not add /login or a trailing slash to these origins.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# NextDNS API credentials (backend only; never expose NEXTDNS_KEY to the FE)
NEXTDNS_KEY=your-nextdns-api-key
NEXTDNS_PROFILE=your-nextdns-profile-id

# VietQR & Payment Configuration
VIETQR_BANK_ID=TPB
VIETQR_ACCOUNT_NO=HUYDEV204
VIETQR_ACCOUNT_NAME=HA QUANG HUY
VIETQR_TEMPLATE=compact2
# Exact accountNumber value(s) returned by SePay. This can differ from the
# VietQR alias above. Separate multiple accepted accounts with commas.
SEPAY_WEBHOOK_ACCOUNT_NUMBERS=
PAYMENT_TRANSFER_PREFIX=LOCKETGOLDHUYDEV
PAYMENT_TRANSFER_DIGITS=3
PAYMENT_TTL_SECONDS=600
PAYMENT_CODE_REUSE_DELAY_SECONDS=86400
PAYMENT_WEBHOOK_ENABLED=0

# SePay webhook HMAC-SHA256 authentication.
# Production URL: https://locketgoldhuy.io.vn/api/payment/webhook
# Set PAYMENT_WEBHOOK_ENABLED=1 only after configuring the same secret in SePay.
# Never commit the real secret. SePay signs: {timestamp}.{raw_body}
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# Bank transaction time may differ slightly from the application server clock.
# Used only to recover a signed, exact-match payment whose webhook arrived late.
SEPAY_TRANSACTION_CLOCK_SKEW_SECONDS=300

# RevenueCat public key (used by LocketAPI.getSubscriber for Gold precheck)
# This is the Locket app's public RevenueCat API key. Safe to include in
# backend-only config — never expose to frontend client.
REVENUECAT_PUBLIC_KEY=
TELEGRAM_NOTIFICATIONS_ENABLED=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_NEW_ORDERS=1
TELEGRAM_NOTIFY_ACTIVATION_SUCCESS=1
TELEGRAM_ADMIN_ORDERS_URL=https://locketgoldhuy.io.vn/admin?tab=orders
