[Unit]
Description=Locket Gold API Service (Flask + Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=locket
Group=locket
UMask=0077
WorkingDirectory=/opt/locket-gold/backend

# Reads runtime environment variables: JWT_SECRET, REFRESH_TOKEN_PEPPER, BEHIND_HTTPS=1, etc.
EnvironmentFile=/etc/locket-gold.env
Environment=PYTHONUNBUFFERED=1
Environment=LOCKET_DB=/var/lib/locket-gold/locket.db
Environment=MOBILECONFIG_PATH=/var/lib/locket-gold/downloads/locket.mobileconfig
Environment=ANDROID_APK_PATH=/var/lib/locket-gold/downloads/Locket_v1.200.0-gocmod.com.apk
Environment=ENABLE_ACCEL_REDIRECT=1

# Writable runtime dir for gunicorn control socket + heartbeats
# (control_socket/worker_tmp_dir in gunicorn.conf.py). Created and owned by the
# service user; removed on stop. Keeps the source tree read-only
# (ProtectSystem=strict) without weakening hardening.
RuntimeDirectory=locket-gold
RuntimeDirectoryMode=0750

# Persistent storage lives under /var/lib (not the read-only source tree).
# Without these, config.py falls back to backend/storage/reviews and logs
# "could not create storage root at storage/reviews: Read-only file system".
Environment=REVIEW_STORAGE_ROOT=/var/lib/locket-gold/storage/reviews
Environment=CREATOR_STORAGE_ROOT=/var/lib/locket-gold/creators

ExecStart=/opt/locket-gold/backend/.venv/bin/gunicorn \
    --config /opt/locket-gold/backend/gunicorn.conf.py \
    wsgi:app

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Memory sizing for 2GB RAM VPS
MemoryHigh=512M
MemoryMax=768M

# Security Hardening - source tree is strictly read-only
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/locket-gold /run/locket-gold
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Logs to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=locket

[Install]
WantedBy=multi-user.target
