{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "bai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "B.AI",
      "options": {
        "baseURL": "https://api.b.ai/v1",
        "apiKey": "{env:BAI_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash"
        },
        "hy3": {
          "name": "Hy3"
        },
        "qwen3.8-flash": {
          "name": "Qwen3.8-Flash"
        }
      }
    },

    "vyce": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VyceAI",
      "options": {
        "baseURL": "https://vyceai.com/v1",
        "apiKey": "{env:VYCEAI_API_KEY}"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6"
        }
      }
    }
  },

  "model": "vyce/claude-sonnet-4-6"
}