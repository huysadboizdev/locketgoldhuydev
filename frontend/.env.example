# Copy this file to frontend/.env for local development.
# Vite exposes every VITE_* value to the browser: never put secrets/API keys here.

# Google Identity Services Web Client ID (this value is public by design).
# It must exactly match backend GOOGLE_CLIENT_ID. Configure authorized origins
# for http://localhost:3000 and the final HTTPS production domain.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
